{
  "name": "slidecraft",
  "version": "0.1.0",
  "private": true,
  "description": "Self-hosted AI presentation workspace that generates editable PowerPoint decks from curated themes and semantic layouts.",
  "license": "MIT",
  "author": "SlideCraft contributors",
  "type": "module",
  "packageManager": "pnpm@11.28.5",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "nuxt typecheck",
    "worker": "tsx worker/index.ts",
    "db:migrate": "tsx server/database/migrate.ts",
    "tasks:prune": "tsx scripts/prune-tasks.ts",
    "office:check": "tsx scripts/check-officecli.ts"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.2.8",
    "@officecli/officecli": "1.0.158",
    "dotenv": "^18.0.9",
    "jszip": "^3.10.2",
    "lucide-vue-next": "^1.0.0",
    "nuxt": "4.6.2",
    "pg-boss": "^12.38.0",
    "postgres": "^3.4.9",
    "pptxgenjs": "^4.0.1",
    "unpdf": "^1.9.1",
    "vue": "^3.5.44",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsx": "^4.20.6",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5",
    "vue-tsc": "^3.1.5"
  }
}
