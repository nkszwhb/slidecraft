# PostgreSQL
# For Docker Compose, POSTGRES_PASSWORD is used by both the database and web/worker.
POSTGRES_PASSWORD=replace-with-strong-database-password
DATABASE_URL=postgres://slidecraft:replace-with-strong-database-password@localhost:5432/slidecraft

# Required. Generate a random value:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
APP_SECRET=replace-with-random-app-secret-at-least-32-characters

# Persisted assets, previews and generated decks
DATA_DIR=./.data

# Optional explicit OfficeCLI binary path
OFFICECLI_BIN=officecli

# Single administrator. ADMIN_PASSWORD empty disables authentication for local development.
# Use a password of at least 12 characters on a network-accessible instance.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-strong-admin-password

# Docker Compose sets this to true. Keep false only for local development.
REQUIRE_SECURE_CONFIG=false
