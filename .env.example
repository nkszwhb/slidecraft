# PostgreSQL
DATABASE_URL=postgres://slidecraft:slidecraft@localhost:5432/slidecraft

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
APP_SECRET=

# Persisted assets, previews and generated decks
DATA_DIR=./.data

# Optional explicit OfficeCLI binary path
OFFICECLI_BIN=officecli

# First-run administrator (used only when the users table is empty)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-now
